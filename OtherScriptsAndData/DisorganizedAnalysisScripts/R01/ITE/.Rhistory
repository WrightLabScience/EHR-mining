{
par(mfrow=c(1,1), mgp=c(2, 0.25, 0), tck=-0.0075, mar=c(3, 8, 2, 0.5))
plotCont <- function(var) {
vec <- df[[var]]
w <- which(df$outcome == 1L)
plot(x=vec[-w], y=df$ite[-w], pch=16, col='#00000022', xlab=stringr::str_to_sentence(var), ylab='',
main = 'MRSA bacteremia - Daptomycin vs. Vancomycin', yaxt='n')
axis(side=2, las=1)
mtext(text='E[Y(1) - Y(0) | X]\n(CATE)', side=2, line=4.5, at=0.25, las=1, adj=0.5)
abline(h=0, lty=3)
lines(smooth.spline(x=vec, y=df$ite, spar = 1))
xpos <- 10
yshift <- 0.05
arrows(x0=xpos, y0=-yshift, y1=yshift, code=3, angle=45, length=0.15, lwd=2)
text(x=xpos, y=yshift * 1.5 * c(-1,1), labels=c('VAN better', 'DAP better'), font=2)
}
plotCont('age')
# plotCont('time')
}
plotStratScat <- function(var, xval_var) {
vec <- df[[var]]
xval <- df[[xval_var]]
plot(x=xval, y=df$ite, pch=16, col=paste0(col_vec[vec + 1L], '22'), xlab=stringr::str_to_sentence(xval_var), ylab='CATE', main=var)
abline(h=0, lty=3)
legend('topleft', col=col_vec, legend=c(F, T), pch=16, bty='n')
}
