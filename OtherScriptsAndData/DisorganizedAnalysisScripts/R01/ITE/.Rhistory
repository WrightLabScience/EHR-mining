plotCDFs <- function(var) {
vec <- df[[var]]
plot(ecdf(df$ite[vec == 1L]), xlim=c(-0.2, 0.7), main=var, lwd=2, col=col_vec[1L + 1L], yaxt='n', xlab='', yaxs='i')
title(xlab='CATE', line=1.2)
axis(side=2, las=1)
lines(ecdf(df$ite[vec == 0L]), lwd=2, col=col_vec[1L + 0L])
abline(v=0, lty=3)
legend('topleft', col=col_vec, legend=c(F, T), lwd=2, bty='n')
}
