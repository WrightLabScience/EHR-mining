plotStratScat <- function(var, xval_var) {
vec <- df[[var]]
xval <- df[[xval_var]]
plot(x=xval, y=df$ite, pch=16, col=paste0(col_vec[vec + 1L], '22'),
xlab=stringr::str_to_sentence(xval_var), ylab='CATE', main=var, yaxt='n')
axis(side=2, las=1)
abline(h=0, lty=3)
legend('topleft', col=col_vec, legend=c(F, T), pch=16, bty='n')
}
