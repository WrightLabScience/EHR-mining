{
pdf(file = paste0(plot_path, bug_name, '.pdf'), height=7.5, width=5)
par(mfrow=c(3,1), tck=-0.015, mgp=c(2, 0.25, 0), mar=c(7.25, 3.5, 1.25, 3))
cex <- 1
